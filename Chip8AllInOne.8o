# 8xy7 test
# initialize registers
8xy7_macro v0 v1 1 1

if va == 0 begin
	# general tests, make sure the opcode works & flags are set properly.
	if vc == 1 begin
		8xy7_macro v0 v1 1 0
		if va == 255 begin
			if vc == 0 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f1
		end
	else
		i := f2
	end
	
	draw_i 12 1 5 0
	
	# flag tests, make sure the flag can be used 
	# vf = x tests
	8xy7_macro vf v0 1 2
	if vc == 1 begin
		8xy7_macro vf v0 1 0
		
		if vc == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 13 1 5 0
	
	# vf = y tests
	8xy7_macro v0 vf 1 1
	if va == 0 begin
		8xy7_macro v0 vf 1 0
		
		if va == 255 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
