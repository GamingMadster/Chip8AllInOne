# macros

# macro for writing text
:macro draw X sX Y sY I {
	# X and Y is the position the text is on screen (with spaces)
	# sX and sY are for positioning the text per pixel

	# mX and mY are the precalculations for the position of the text on the screen
	:calc mX { ( X * 4 ) + 1 + sX }
	:calc mY { ( Y * 5 ) + 1 + sY }
	
	# set the index register to the proper font address indicated by "I"
	i := I
	
	# set vD and vE to the precalculated positions
	vd := mX
	ve := mY
	
	# draw the letter
	sprite vd ve 4
}

# macro for drawing more precisely
:macro precise_draw X Y I N {
	vd := X
	ve := Y
	i := I
	
	sprite vd ve N
}

# macro for writing text (universal I)
:macro draw_i X sX Y sY {
	# X and Y is the position the text is on screen (with spaces)
	# sX and sY are for positioning the text per pixel

	# mX and mY are the precalculations for the position of the text on the screen
	:calc mX { ( X * 4 ) + 1 + sX }
	:calc mY { ( Y * 5 ) + 1 + sY }
	
	# set vD and vE to the precalculated positions
	vd := mX
	ve := mY
	
	# draw the letter
	sprite vd ve 4
}

# macro for writing text (unchanged Y)
:macro draw_next X sX I {
	:calc mX { ( X * 4 ) + 1 + sX }
	
	i := I
	
	vd := mX
	
	sprite vd ve 4
}

# macro for writing text (unchanged Y)
:macro draw_down Y sY I {
	:calc mY { ( Y * 5 ) + 1 + sY }
	
	i := I
	
	ve := mY
	
	sprite vd ve 4
}

:macro init_reg rA rB A B {
	# set vf to 170 (in binary "10101010")
	vf := 170
	
	# set rA and rB to values indicated by A and B
	rA := A
	rB := B
}

:macro ret_result rA rB {
# set results from a test to rA, rB, and vf to top three UNUSED registers
	va := rA
	vb := rB
	vc := vf
}

# vip test macro
:macro fontcheck n {
	load v0
	if v0 != n then jump vip-fail
}

:macro 8xy4_macro rA rB A B {
	# initialize registers
	init_reg rA rB A B
	
	# perform test
	rA += rB
	
	# return the result of the test
	ret_result rA rB
}

:macro 8xy5_macro rA rB A B {
	# initialize registers
	init_reg rA rB A B
	
	# perform test
	rA -= rB
	
	# return the result of the test
	ret_result rA rB
}

:macro 8xy7_macro rA rB A B {
	# initialize registers
	init_reg rA rB A B
	
	# perform test
	rA =- rB
	
	# return the result of the test
	ret_result rA rB
}

:macro 8xy6_macro rA rB A B {
	# initialize registers
	init_reg rA rB A B
	
	# perform test
	rA >>= rB
	
	# return the result of the test
	ret_result rA rB
}

:macro 8xye_macro rA rB A B {
	# initialize registers
	init_reg rA rB A B
	
	# perform test
	rA <<= rB
	
	# return the result of the test
	ret_result rA rB
}

: main
clear

# init
draw 0 0 0 0 fC
draw_next 1 0 fH
draw_next 2 0 fI
draw_next 3 0 fP
draw_next 4 0 f8

draw 0 0 1 0 fA
draw_next 1 0 fL
draw_next 2 0 fL
draw_next 3 0 f-
draw_next 4 0 fI
draw_next 5 0 fN
draw_next 6 0 f-
draw_next 7 0 fO
draw_next 8 0 fN
draw_next 9 0 fE

# version
draw 12 1 5 1 fV
draw_next 13 1 f4
draw_next 14 0 f.
draw_next 15 -1 f0

# "PRESS KEYPAD TO CONTINUE" text
draw 0 0 4 1 fP
draw_next 1 0 fR
draw_next 2 0 fE
draw_next 3 0 fS
draw_next 4 0 fS

draw 6 0 4 1 fK
draw_next 7 0 fE
draw_next 8 0 fY
draw_next 9 0 fP
draw_next 10 0 fA
draw_next 11 0 fD

draw 0 0 5 1 fT
draw_next 1 0 fO

draw 3 0 5 1 fC
draw_next 4 0 fO
draw_next 5 0 fN
draw_next 6 0 fT
draw_next 7 0 fI
draw_next 8 0 fN
draw_next 9 0 fU
draw_next 10 0 fE

# wait for key press and clear the screen
v0 := key
clear

# conditionals testing, setup text
draw 0 0 0 0 fC
draw_next 1 0 fO
draw_next 2 0 fN
draw_next 3 0 fD
draw_next 4 0 fI
draw_next 5 0 fT
draw_next 6 0 fI
draw_next 7 0 fO
draw_next 8 0 fN
draw_next 9 0 fA
draw_next 10 0 fL
draw_next 11 0 fS

draw 0 0 2 0 f3
draw_next 1 0 fX
draw_next 2 0 fNN

draw 0 0 3 0 f4
draw_next 1 0 fX
draw_next 2 0 fNN

draw 0 0 4 0 f5
draw_next 1 0 fXY
draw_next 3 0 f0

draw 0 0 5 0 f9
draw_next 1 0 fXY
draw_next 3 0 f0

# 3xnn test

# initialize registers
v0 := 0

# checks for the case where the opcode always jumps, fail on code 1 if so.
if v0 != 0 then jump 3xnn_fail_1

# checks for if the opcode actually works.
if v0 != 1 then jump 3xnn_pass

# if this jump occurs, the opcode is unimplemented and will show as an "X."
jump 3xnn_unim

: 3xnn_pass
i := fPASS
jump 3xnn_comp

: 3xnn_fail_1
i := f1
jump 3xnn_comp

: 3xnn_unim
i := f-

: 3xnn_comp
draw_i 4 1 2 0

# 4xnn test

# checks for the case where the opcode always jumps, fail on code 1 if so.
if v0 == 1 then jump 4xnn_fail_1

# checks for if the opcode actually works.
if v0 == 0 then jump 4xnn_pass

# if this jump occurs, the opcode is unimplemented and will show as an "X."
jump 4xnn_unim

: 4xnn_pass
i := fPASS
jump 4xnn_comp

: 4xnn_fail_1
i := f1
jump 4xnn_comp

: 4xnn_unim
i := f-

: 4xnn_comp
draw_i 4 1 3 0

# 5xy0 test

# initialize registers
v1 := 1

# check for the case where the opcode always jumps, fail on code 1 if so.
if v0 != v0 then jump 5xy0_fail_1

# checks for if the opcode actually works.
if v0 != v1 then jump 5xy0_pass

# if this jump occurs, the opcode is unimplemented and will show as an "X."
jump 5xy0_unim

: 5xy0_pass
i := fPASS
jump 5xy0_comp

: 5xy0_fail_1
i := f1
jump 5xy0_comp

: 5xy0_unim
i := f-

: 5xy0_comp
draw_i 4 1 4 0

# 9xy0 test

# check for the case where the opcode always jumps, fail on code 1 if so.
if v0 == v1 then jump 9xy0_fail_1

# checks for if the opcode actually works.
if v0 == v0 then jump 9xy0_pass

# if this jump occurs, the opcode is unimplemented and will show as an "X."
jump 9xy0_unim

: 9xy0_pass
i := fPASS
jump 9xy0_comp

: 9xy0_fail_1
i := f1
jump 9xy0_comp

: 9xy0_unim
i := f-

: 9xy0_comp
draw_i 4 1 5 0

# wait for key press and clear the screen
v0 := key
clear

# subroutine testing, setup text
draw 0 0 0 0 fS
draw_next 1 0 fU
draw_next 2 0 fB
draw_next 3 0 fR
draw_next 4 0 fO
draw_next 5 0 fU
draw_next 6 0 fT
draw_next 7 0 fI
draw_next 8 0 fN
draw_next 9 0 fE
draw_next 10 0 fS

draw 0 0 2 0 f2
draw_next 1 0 fN
draw_next 2 0 fNN

draw 0 0 3 0 f00
draw_next 2 0 fEE

# subroutines for 2nnn and 00EE are combined.

# initialize registers
v0 := 0

# subroutine test

# call subroutine (2nnn)
:call sub_test

# if v0 stays zero, assume that the call wasn't ran, and mark both opcodes as unimplemented
if v0 == 0 begin
	draw 4 1 2 0 f-
	draw_down 3 0 f-
	jump sub_comp
end

# if v0 is changed to one, then both opcodes are passing
if v0 == 1 begin
	draw 4 1 3 0 fPASS
	jump sub_comp
end

: sub_test
	v0 := 1
	draw 4 1 2 0 fPASS
return
	
# If the subroutine doesn't return, assume 00EE is not implemented.
	draw 4 1 3 0 f-
	
: sub_comp

# wait for key press and clear the screen
v0 := key
clear

# arithmetic testing, setup text
draw 0 0 0 0 fA
draw_next 1 0 fR
draw_next 2 0 fI
draw_next 3 0 fT
draw_next 4 0 fH
draw_next 5 0 fM
draw_next 6 0 fE
draw_next 7 0 fT
draw_next 8 0 fI
draw_next 9 0 fC

draw_next 11 0 fP
draw_next 12 0 fG
draw_next 13 0 f.
draw_next 14 0 f1

draw 0 0 2 0 f7
draw_next 1 0 fX
draw_next 2 0 fNN

draw 0 0 3 0 f8
draw_next 1 0 fXY
draw_next 3 0 f0

draw 0 0 4 0 f8
draw_next 1 0 fXY
draw_next 3 0 f1

draw 0 0 5 0 f8
draw_next 1 0 fXY
draw_next 3 0 f2

draw 8 0 2 0 f8
draw_next 9 0 fXY
draw_next 11 0 f3

draw 8 0 3 0 f8
draw_next 9 0 fXY
draw_next 11 0 f4

draw 8 0 4 0 f8
draw_next 9 0 fXY
draw_next 11 0 f5

draw 8 0 5 0 f8
draw_next 9 0 fXY
draw_next 11 0 f7

# 7xnn test
# initialize registers
v0 := 0

v0 += 1

if v0 == 1 begin
	i := fPASS
else
	i := f-
end

: 7xnn_comp
draw_i 4 1 2 0

# 8xy0 test
# initialize registers
v0 := 1
v1 := 0

v1 := v0

# check if v1 got v0's value
if v1 == 1 begin
	# if v1 got v0's value then mark it as a pass
	i := fPASS
else
	# this draw only occurs if v1 does not get v0's value (unimplemented.)
	i := f-
end

: 8xy0_comp
draw_i 4 1 3 0

# 8xy1 test
# initialize registers
v0 := 170
v1 := 0
vf := 0xFF

v1 |= v0

vc := vf

# check if v1 is v1 | v0
if v1 == 170 begin
	# if v1 is v1 | v0 then mark it as a pass
	draw 4 1 4 0 fPASS
	
	# check if the vf reset quirk is working as expected
	if vc == 0 begin
		# 8xy1 flag test
		# initalize registers
		v0 := 170
		vf := 0

		vf |= v0
		
		# if vf is zero, pass the flag test. Otherwise, error on code 2.
		if vf == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		if vc == 0xFF begin
			# if vf is unchanged, the quirk is inactive/unimplemented, so skip the flag test
			i := f-
		else
			# vf has been changed, but to a nonsensical value, error on code 1.
			i := f1
		end
	end
	
	draw_i 5 1 4 0
	
	jump 8xy1_comp
else
	# this draw only occurs if v1 is not v1 | v0 (unimplemented.)
	draw 4 1 4 0 f-
	draw_next 5 1 f-
end

: 8xy1_comp

# 8xy2 test
# initialize registers
v0 := 255
v1 := 15
vf := 0xFF

v0 &= v1

vc := vf

# check if v1 is v1 & v0
if v0 == 15 begin
	# if v1 is v1 & v0 then mark it as a pass
	draw 4 1 5 0 fPASS
	
	# check if the vf reset quirk is working as expected
	if vc == 0 begin
		# 8xy2 flag test
		# initalize registers
		v0 := 15
		vf := 255

		vf &= v0
		
		# if vf is zero, pass the flag test. Otherwise, error on code 2.
		if vf == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		if vc == 0xFF begin
			# if vf is unchanged, the quirk is inactive/unimplemented, so skip the flag test
			i := f-
		else
			# vf has been changed, but to a nonsensical value, error on code 1.
			i := f1
		end
	end
	
	draw_i 5 1 5 0
	
	jump 8xy2_comp
else
	# this draw only occurs if v1 is not v1 & v0 (unimplemented.)
	draw 4 1 5 0 f-
	draw_next 5 1 f-
end

: 8xy2_comp

# 8xy3 test
# initialize registers
v0 := 255
v1 := 15
vf := 0xFF

v0 ^= v1

vc := vf

# check if v1 is v1 ^ v0
if v0 == 0xF0 begin
	# if v1 is v1 ^ v0 then mark it as a pass
	draw 12 1 2 0 fPASS
	
	# check if the vf reset quirk is working as expected
	if vc == 0 begin
		# 8xy3 flag test
		# initalize registers
		v0 := 15
		vf := 255

		vf ^= v0
		
		# if vf is zero, pass the flag test. Otherwise, error on code 2.
		if vf == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		if vc == 255 begin
			# if vf is unchanged, the quirk is inactive/unimplemented, so skip the flag test
			i := f-
		else
			# vf has been changed, but to a nonsensical value, error on code 1.
			i := f1
		end
	end
	
	draw_i 13 1 2 0
	
	jump 8xy3_comp
else
	# this draw only occurs if v1 is not v1 ^ v0 (unimplemented.)
	draw 12 1 2 0 f-
	draw_next 13 1 f-
end

: 8xy3_comp

# 8xy4 test
# initialize registers
8xy4_macro v0 v1 0 1

if va == 1 begin
	# general tests, make sure the opcode works & flags are set properly.
	if vc == 0 begin
		8xy4_macro v0 v1 1 255
		if va == 0 begin
			if vc == 1 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f1
		end
	else
		i := f2
	end
	
	draw_i 12 1 3 0
	
	# flag tests, make sure the flag can be used 
	# vf = x tests
	8xy4_macro vf v0 1 1
	if vc == 0 begin
		8xy4_macro vf v0 255 1
		
		if vc == 1 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 13 1 3 0
	
	# vf = y tests
	8xy4_macro v0 vf 0 1
	if va == 1 begin
		8xy4_macro v0 vf 1 255
		
		if va == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 14 1 3 0
else
	draw 12 1 3 0 f-
	draw_next 13 1 f-
end

