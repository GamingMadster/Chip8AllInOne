: 8xy7_comp

# wait for key press and clear the screen
v0 := key
clear

# arithmetic testing, setup text
draw 0 0 0 0 fA
draw_next 1 0 fR
draw_next 2 0 fI
draw_next 3 0 fT
draw_next 4 0 fH
draw_next 5 0 fM
draw_next 6 0 fE
draw_next 7 0 fT
draw_next 8 0 fI
draw_next 9 0 fC

draw_next 11 0 fP
draw_next 12 0 fG
draw_next 13 -1 f.
draw_next 14 -2 f2

draw 0 0 2 0 f8
draw_next 1 0 fXY
draw_next 3 0 f6

draw 0 0 3 0 f8
draw_next 1 0 fXY
draw_next 3 0 fE

# 8xy6 test
8xy6_macro v0 v1 2 2

# test if v0 was shifted right properly
if va == 1 begin
	# check if v1 is unchanged
	if vb == 2 begin
		# check if the flag is set properly
		if vc == 0 begin
			# do a check for if bits are being set into the flag register properly
			8xy6_macro v0 v1 3 3
			if vc == 1 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 4 1 2 0
	
	# flag tests
	# vf = x
	8xy6_macro vf v0 3 3
	if vc == 1 begin
		8xy6_macro vf v0 2 2
		if vc == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 5 1 2 0
	
	# vf = y (ONLY TRIGGERS IF SHIFTING IS VX >>= VY)
	8xy6_macro v0 vf 0 3
	if va == 1 begin
		if vc == 1 begin
			8xy6_macro v0 vf 0 2
			if vc == 0 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f2
		end
	else
		# if the shifting quirk of vx >>= vx occurs, make sure that vf is still set to zero
		if vc == 0 begin
			i := f-
		else
			i := f1
		end
	end
	
	draw_i 6 1 2 0
else
	draw 4 1 2 0 f-
	draw_next 5 1 f-
	draw_next 6 1 f-
end

: 8xy6_comp

# 8xye test
8xye_macro v0 v1 1 1

# test if v0 was shifted right properly
if va == 2 begin
	# check if v1 is unchanged
	if vb == 1 begin
		# check if the flag is set properly
		if vc == 0 begin
			# do a check for if bits are being set into the flag register properly
			8xye_macro v0 v1 128 128
			if vc == 1 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 4 1 3 0
	
	# flag tests
	# vf = x
	8xye_macro vf v0 128 128
	if vc == 1 begin
		8xye_macro vf v0 1 1
		if vc == 0 begin
			i := fPASS
		else
			i := f2
		end
	else
		i := f1
	end
	
	draw_i 5 1 3 0
	
	# vf = y (ONLY TRIGGERS IF SHIFTING IS VX >>= VY)
	8xye_macro v0 vf 1 128
	if va == 0 begin
		if vc == 1 begin
			8xye_macro v0 vf 0 1
			if vc == 0 begin
				i := fPASS
			else
				i := f3
			end
		else
			i := f2
		end
	else
		# if the shifting quirk of vx >>= vx occurs, make sure that vf is still set to zero
		if vc == 0 begin
			i := f-
		else
			i := f1
		end
	end
	
	draw_i 6 1 3 0
else
	draw 4 1 3 0 f-
	draw_next 5 1 f-
	draw_next 6 1 f-
end

: 8xye_comp

# wait for key press and clear the screen
v0 := key
clear

# memory testing
draw 0 0 0 0 fM
draw_next 1 0 fE
draw_next 2 0 fM
draw_next 3 0 fO
draw_next 4 0 fR
draw_next 5 0 fY

draw 0 0 2 0 fF
draw_next 1 0 fX
draw_next 2 0 f5
draw_next 3 0 f5

draw 0 0 3 0 fF
draw_next 1 0 fX
draw_next 2 0 f6
draw_next 3 0 f5

draw 0 0 4 0 fF
draw_next 1 0 fX
draw_next 2 0 f1
draw_next 3 0 fE

# fx55 & fx65 test
i := 0xFFF
v0 := 0xAA

save v0

i := 0xFFF
v0 := 0x00

load v0

i := f1
if v0 == 0xAA then i := fPASS
if v0 == 0x00 then i := f-
draw_i 4 1 2 0
draw_i 4 1 3 0

# fx1e test
vf := 0xFF
v0 := 1
i := scratchpad

i += v0

load v0

i := f1
if v0 == 0x55 then i := fPASS
if v0 == 0xAA then i := f-

draw_i 4 1 4 0

i := f1
if vf != 0xFF then i := fPASS

draw_i 5 1 4 0

# wait for key press and clear the screen
v0 := key
clear

# vip test (taken from side-project "vipchecker.8o".)
draw 0 0 0 0 fO
draw_next 1 0 fT
draw_next 2 0 fH
draw_next 3 0 fE
draw_next 4 0 fR

draw 0 0 2 0 fV
draw_next 1 0 fI
draw_next 2 0 fP

# Test 1: ROM exists at $8000
# This test is to check for if the Index register is a 16-bit value
# and doesn't wrap around the 4kb memory area that a regular
# interpreter would be able to see. (AKA, the VIP's addressing
# space.)

# This test also checks for if ROM exists at $8000. As such, a write
# To the area should not affect $0000.

# Set I to $FFF, and then increment I to $8000. If this is
# done within a regular interpreter, the interpreter is understood 
# to wrap the value back to zero every time I goes over $0FFF. If this is
# done on the VIP, the I register should not wrap via $0FFF.

i := 0x0fff
v0 := 0xff
v1 := 0x00

loop
	i += v0
	v1 += 0x01
if v1 != 0x70 then again

v0 := 0x71
i += v0

# attempt to save the value $AA (or b10101010) at what is presumed
# to be $1000. If the value is found at 0, then assume that this
# rom is running on a normal high-level chip-8 interpreter, rather
# than on a VIP running the chip-8 interpreter.
v0 := 0xaa
save v0

i := 0x0000

# set v0 to a known value that would not appear in the font (to 
# prevent false positives & negatives)
v0 := 0x55

load v0

# if the test fails, jump to the end automatically.
if v0 == 0xaa then
		jump vip-fail

# Test 2: $F00 - $FFF is the framebuffer
# This test is to check if the framebuffer is seperate from the
# main memory that the CHIP-8 interpreter is able to "see"

# In the case of the VIP, the framebuffer is contained from $F00
# to $FFF.

# Set I to $FFF and set register "v0" to $FF and save that to $FFF
i := 0x0fff

v0 := 0xff

save v0

precise_draw 0x38 0x1f line 1

if vf == 0x00 begin
	precise_draw 0x38 0x1f line 1
	jump vip-fail
end

# Test 3: Font Graphics stored in the VIP's memory at $8110 - $8142
# This checks for EVERY byte of the font being at $8110 to $8142 is
# correct. If any byte is incorrect or doesn't exist, the test will
# fail.

# Increment I for a while to get I to $8110

i := 0x0fff

v0 := 0xff
v1 := 0x00

loop
	i += v0
	v1 += 0x01
if v1 != 0x71 then again

v0 := 0x82

i += v0

# The monotonous font check...

fontcheck 0xf0
fontcheck 0x80
fontcheck 0xf0
fontcheck 0x80
fontcheck 0xf0
fontcheck 0x80
fontcheck 0x80
fontcheck 0x80
fontcheck 0xf0
fontcheck 0x50
fontcheck 0x70
fontcheck 0x50
fontcheck 0xf0
fontcheck 0x50
fontcheck 0x50
fontcheck 0x50
fontcheck 0xf0
fontcheck 0x80
fontcheck 0xf0
fontcheck 0x10
fontcheck 0xf0
fontcheck 0x80
fontcheck 0xf0
fontcheck 0x90
fontcheck 0xf0
fontcheck 0x90
fontcheck 0xf0
fontcheck 0x10
fontcheck 0xf0
fontcheck 0x10
fontcheck 0xf0
fontcheck 0x90
fontcheck 0xf0
fontcheck 0x90
fontcheck 0x90
fontcheck 0x90
fontcheck 0xf0
fontcheck 0x10
fontcheck 0x10
fontcheck 0x10
fontcheck 0x10
fontcheck 0x60
fontcheck 0x20
fontcheck 0x20
fontcheck 0x20
fontcheck 0x70
fontcheck 0xa0
fontcheck 0xa0
fontcheck 0xf0
fontcheck 0x20
fontcheck 0x20

# Test 4: Display wait quirk parity
# This checks for if the display wait quirk has parity with how
# the VIP's display wait quirk functions.

# Note: These timings were tested using EMMA 02 v1.47 at a
# 1.7609 MHz clock speed.

# PART A
v2 := 0x77
delay := v2

i := vert-line

v0 := 0x10
v1 := 0x00

# loop repeatedly for 119 frames
loop
	v2 := delay
	sprite v0 v0 0x01
	v1 += 0x01
if v2 != 0x00 then again

# if we dont get a count of 120, the test fails.
if v1 != 0x78 then
		jump vip-fail

# PART B
v2 := 0x76
delay := v2

v0 := 0x15
v1 := 0x00

# loop repeatedly for 118 frames
loop
	v2 := delay
	sprite v0 v0 0x08
	v1 += 0x01
if v2 != 0x00 then again

# if we dont get a count of 60, the test fails.
if v1 != 0x3c then
		jump vip-fail

# PART C
v2 := 0x77
delay := v2

v0 := 0x10
v1 := 0x00

# loop repeatedly for 119 frames
loop
	v2 := delay
	sprite v0 v0 0x08
	v1 += 0x01
if v2 != 0x00 then again

# if we dont get a count of 120, the test fails.
if v1 != 0x78 then
		jump vip-fail

# if the test didn't jump to "fail", draw the pass symbol, and then
# jump to the loop again at "testend"
: vip-pass
	draw 3 1 2 0 fPASS
	jump vip-finish
	
: vip-fail
	draw 3 1 2 0 f-
	
: vip-finish
v0 := key
clear

jump 0x200

